{
  "name": "shopnow",
  "private": true,
  "version": "2.0.0",
  "description": "ShopNow v2 — sàn TMĐT microservice (DevSecOps + AIOps thesis)",
  "packageManager": "pnpm@10.8.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r --parallel --filter \"./packages/*\" --filter \"./services/*\" run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./services/*\" run test",
    "build": "pnpm -r --filter \"./services/*\" run build",
    "infra:up": "docker compose -f deploy/compose/infra.yml up -d",
    "infra:down": "docker compose -f deploy/compose/infra.yml down",
    "dev": "bash scripts/dev.sh",
    "e2e": "tsx tests/e2e/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
