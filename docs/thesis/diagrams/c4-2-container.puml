@startuml c4-2-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title C4 mức 2 — Container ShopNow v2

Person(user, "Người mua / bán / admin")
System_Boundary(sn, "ShopNow v2 (Kubernetes namespace shopnow)") {
  Container(web, "web", "Next.js 15", "3 cổng: người mua · Seller Center · Admin")
  Container(gw, "api-gateway", "Node/Fastify", "Định tuyến, JWT, rate limit, BFF")
  Container(identity, "identity", "Node", "Đăng ký, OTP, JWT RS256/JWKS, 2FA")
  Container(profile, "user-profile", "Node", "Hồ sơ, địa chỉ, wishlist")
  Container(seller, "seller", "Node", "Shop, KYC, duyệt")
  Container(catalog, "catalog", "Node", "Danh mục, sản phẩm, biến thể, banner")
  Container(search, "search", "Node", "Tìm kiếm, facet, gợi ý")
  Container(inventory, "inventory", "Go", "Tồn kho, giữ chỗ TTL")
  Container(cart, "cart", "Node", "Giỏ hàng")
  Container(promo, "promotion", "Node", "Voucher, flash sale")
  Container(order, "order", "Node", "Checkout, saga, trả hàng, thống kê")
  Container(payment, "payment", "Node", "COD/MOCK/VNPay, hoàn tiền, ví seller")
  Container(shipping, "shipping", "Node", "Phí ship, vận đơn")
  Container(review, "review", "Node", "Đánh giá")
  Container(notif, "notification", "Node", "In-app SSE, email")
  Container(ai, "ai-service", "Python/FastAPI", "Gợi ý, RAG chatbot, kiểm duyệt")
  ContainerQueue(kafka, "Kafka", "Strimzi / Redpanda", "10 topic *.v1 + DLQ")
  ContainerDb(pg, "PostgreSQL", "CloudNativePG / RDS", "1 database / service")
  ContainerDb(redis, "Redis", "ElastiCache / in-cluster", "Giỏ, rate limit, flash sale Lua, pub/sub")
  ContainerDb(mongo, "MongoDB", "", "review, notification")
  ContainerDb(os, "OpenSearch", "", "Chỉ mục tìm kiếm")
  ContainerDb(s3, "S3 / MinIO", "", "Ảnh sản phẩm (presigned)")
}
Rel(user, web, "HTTPS")
Rel(web, gw, "/api/*", "JSON")
Rel(gw, identity, "proxy")
Rel(gw, catalog, "proxy + BFF")
Rel(gw, order, "proxy")
Rel(order, catalog, "/internal/skus")
Rel(order, promo, "/quote")
Rel(order, shipping, "/quote")
Rel(order, kafka, "outbox: order.v1, inventory.command.v1, payment.command.v1")
Rel(kafka, inventory, "inventory.command.v1")
Rel(inventory, kafka, "inventory.event.v1")
Rel(kafka, payment, "payment.command.v1")
Rel(payment, kafka, "payment.event.v1")
Rel(kafka, shipping, "order.confirmed")
Rel(shipping, kafka, "shipping.v1")
Rel(kafka, notif, "mọi sự kiện")
Rel(kafka, search, "catalog.product.v1")
Rel(kafka, ai, "product, order.completed")
Rel(catalog, s3, "ký URL")
Rel(catalog, pg, "SQL")
Rel(order, pg, "SQL")
Rel(cart, redis, "")
Rel(review, mongo, "")
Rel(search, os, "")
@enduml
